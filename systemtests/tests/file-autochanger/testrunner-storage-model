set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

# shellcheck source=../../environment.in
. ./environment

# shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

# Check that the director builds its storage model from the autochanger
# inventory of the storage daemon and compares it with the catalog.

start_test

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out ${tmp}/model.out
status storage=File model
@$out ${tmp}/label.out
label barcodes slots=3-4 drive=0 pool=Differential yes
@$out ${tmp}/model-labeled.out
status storage=File model
@# keep 000004HD loaded, the job should append to it
@$out ${tmp}/job.out
run job=backup-bareos-fd level=Full pool=Differential storage=File yes
wait
messages
@$out ${tmp}/model-after-job.out
status storage=File model
@# the catalog is wrong, the director corrects it from the changer listing
@$out ${tmp}/wrong-slot.out
release drive=0
update volume=000004HD slot=5
status storage=File model
@$out ${tmp}/job-wrong-slot.out
run job=backup-bareos-fd level=Full pool=Differential storage=File yes
wait
messages
@$out ${tmp}/list-after-correction.out
list volume=000004HD
@# the restore leases the volume it reads
setdebug level=100 trace=1 director
@$out ${tmp}/restore.out
restore client=bareos-fd where=${tmp}/bareos-restores select all done yes
wait
messages
@$out ${tmp}/model-after-restore.out
setdebug level=0 trace=0 director
status storage=File model
@$out ${tmp}/release.out
release drive=0
release drive=1
release drive=2
@# later tests expect no previous backup
purge jobs client=bareos-fd yes
END_OF_DATA

run_bconsole "$@"

expect_grep 'Storage "File": 4 drive(s)' "${tmp}/model.out" \
  "model does not contain the drives of the autochanger"
expect_grep '^  Drive-3: empty, device "File4"$' "${tmp}/model.out" \
  "model does not map device File4 to drive 3"
expect_grep '^  Slot 2: "000002HD"$' "${tmp}/model.out" \
  "model does not contain the volume in slot 2"
expect_grep '^  Slot 34: empty$' "${tmp}/model.out" \
  "model does not contain the import/export slots"
expect_grep 'Volume "000002HD": catalog not present, storage daemon slot 2' \
  "${tmp}/model.out" \
  "unlabeled volume in slot 2 is not reported as divergence"

expect_grep 'OK label.*"000004HD"' "${tmp}/label.out" \
  "volume in slot 4 was not labeled"
expect_grep '^  Drive-0: volume "000004HD" from slot 4, device "File1"$' \
  "${tmp}/model-labeled.out" \
  "model does not show the labeled volume in drive 0"
expect_not_grep 'Volume "000004HD"' "${tmp}/model-labeled.out" \
  "labeled volume is reported as divergence"
expect_grep 'Volume "000005HD": catalog not present, storage daemon slot 5' \
  "${tmp}/model-labeled.out" \
  "unlabeled volume in slot 5 is not reported as divergence"

expect_grep "Backup OK" "${tmp}/job.out" "backup was not successful"
expect_grep 'Volume name(s):.*000004HD' "${tmp}/job.out" \
  "job did not append to the volume already loaded in a drive"
expect_not_grep '3307 Issuing autochanger "unload' "${tmp}/job.out" \
  "job changed the volume instead of using the loaded one"
expect_grep '^  Drive-0: volume "000004HD" from slot 4, appending, device "File1"$' \
  "${tmp}/model-after-job.out" \
  "model does not show the drive used by the job"
expect_not_grep "JobId" "${tmp}/model-after-job.out" \
  "volume lease was not released at the end of the job"

expect_grep "Backup OK" "${tmp}/job-wrong-slot.out" \
  "backup with a wrong slot in the catalog was not successful"
expect_grep 'Volume "000004HD" is in slot 4 of storage "File", the catalog said slot 5' \
  "${tmp}/job-wrong-slot.out" \
  "director did not correct the slot of the volume"
expect_grep 'load slot 4' "${tmp}/job-wrong-slot.out" \
  "storage daemon did not load the corrected slot"
expect_grep '| *000004HD *|.*| *4 *|' "${tmp}/list-after-correction.out" \
  "catalog slot of the volume was not corrected"

expect_grep "Restore OK" "${tmp}/restore.out" "restore was not successful"
expect_grep 'Read lease on volume 000004HD in Drive-' \
  "${working_dir}/bareos-dir.trace" \
  "restore did not lease the volume it reads"
expect_not_grep "JobId" "${tmp}/model-after-restore.out" \
  "read lease was not released at the end of the restore"

# A restarted storage daemon may see other volumes in the changer: the
# director notices the restart, lists the changer again and corrects the
# catalog before the next job.
cat <<END_OF_DATA >"$tmp/bconcmds-restart"
@$out ${NULL_DEV}
status storage=File model
update volume=000004HD slot=6
END_OF_DATA
run_bconsole "$tmp/bconcmds-restart"

"${BAREOS_SCRIPTS_DIR}"/bareos-ctl-sd stop
"${BAREOS_SCRIPTS_DIR}"/bareos-ctl-sd start
sleep 2

cat <<END_OF_DATA >"$tmp/bconcmds-restart"
@$out ${NULL_DEV}
messages
setdebug level=100 trace=1 director
@$out ${tmp}/job-after-restart.out
run job=backup-bareos-fd level=Full pool=Differential storage=File yes
wait
messages
@$out ${tmp}/list-after-restart.out
setdebug level=0 trace=0 director
list volume=000004HD
@$out ${NULL_DEV}
release drive=0
release drive=1
release drive=2
purge jobs client=bareos-fd yes
END_OF_DATA
run_bconsole "$tmp/bconcmds-restart"

expect_grep "Backup OK" "${tmp}/job-after-restart.out" \
  "backup after a storage daemon restart was not successful"
expect_grep 'Storage daemon of storage File restarted' \
  "${working_dir}/bareos-dir.trace" \
  "director did not notice the storage daemon restart"
expect_grep 'Listing the changer of storage File' \
  "${working_dir}/bareos-dir.trace" \
  "director did not list the changer after the restart"
expect_grep 'Volume "000004HD" is in slot 4 of storage "File", the catalog said slot 6' \
  "${tmp}/job-after-restart.out" \
  "director did not correct the catalog after the restart"
expect_grep '| *000004HD *|.*| *4 *|' "${tmp}/list-after-restart.out" \
  "catalog slot was not corrected after the restart"

end_test
