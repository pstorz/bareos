#!/bin/bash
set -e
set -o pipefail
set -u
#
# System test: full backup and restore using SCRAM-SHA-256 authentication
# between all Bareos daemons inside a TLS-PSK tunnel.
#
# Director↔FD and Director↔SD connections use ScramPassword (cleartext)
# for both TLS-PSK key derivation and SCRAM-SHA-256 authentication.
# FD↔SD data transfer uses the job session key (CRAM-MD5, unchanged).
#
TestName="$(basename "$(pwd)")"
export TestName

JobName=backup-bareos-fd

#shellcheck source=../../environment.in
. ./environment

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions
"${BAREOS_SCRIPTS_DIR}"/cleanup
"${BAREOS_SCRIPTS_DIR}"/setup

start_test

setup_data

start_bareos

cat <<END_OF_DATA >"$tmp/bconcmds"
@$out ${NULL_DEV}
messages
@$out $tmp/log1.out
setdebug level=100 storage=File
list volumes
list jobs
label volume=TestVolume001 storage=File pool=Full
run job=$JobName yes
status director
status client
status storage=File
wait
messages
@#
@# now do a restore
@#
@$out $tmp/log2.out
wait
messages
restore client=bareos-fd fileset=SelfTest where=$tmp/bareos-restores select all done yes
wait
messages
quit
END_OF_DATA

run_bconsole
check_for_zombie_jobs storage=File

check_two_logs
check_restore_diff "${BackupDirectory}"

stop_bareos

end_test
