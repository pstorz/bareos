set -e
set -o pipefail
set -u

TestName="$(basename "$(pwd)")"
export TestName

#shellcheck source=../../environment.in
. ./environment

runner_name="$(basename "$0")"
runner_tmp="${tmp}/${runner_name}"
mkdir -p "${runner_tmp}"

#shellcheck source=../../scripts/functions
. "${BAREOS_SCRIPTS_DIR}"/functions

start_test

issue_log="${runner_tmp}/issue-2233.out"
job_count=5

rm -f "${issue_log}"
rm -rf storage/issue2233-vtape
rm -f "${tmp}/issue2233-small-file-list" \
  "${tmp}/issue2233-large-file-list" \
  "${tmp}/issue2233-huge-file-list"
rm -f "${BackupDirectory}/issue2233-small.bin"
rm -f "${BackupDirectory}/issue2233-large.bin"
rm -f "${BackupDirectory}/issue2233-huge.bin"

dd if=/dev/zero \
  of="${BackupDirectory}/issue2233-small.bin" \
  bs=1M \
  count=2 \
  status=none

dd if=/dev/zero \
  of="${BackupDirectory}/issue2233-large.bin" \
  bs=1M \
  count=4 \
  status=none

dd if=/dev/zero \
  of="${BackupDirectory}/issue2233-huge.bin" \
  bs=1M \
  count=16 \
  status=none

printf '%s\n' "${BackupDirectory}/issue2233-small.bin" \
  >"${tmp}/issue2233-small-file-list"
printf '%s\n' "${BackupDirectory}/issue2233-large.bin" \
  >"${tmp}/issue2233-large-file-list"
printf '%s\n' "${BackupDirectory}/issue2233-huge.bin" \
  >"${tmp}/issue2233-huge-file-list"

: >"${logdir}/bareos.log"

tracefile="$(bin/bconsole <<<"setdebug level=250 trace=1 storage=VirtualTape" \
  | awk -F"tracefile=" '/^3000/ {print $2}')"
: >"${tracefile}"

bin/bconsole <<<"label volume=Issue2233Vol storage=VirtualTape pool=Full yes" \
  | grep -E "(OK label|already exists)"

cat <<END_OF_DATA >"${tmp}/bconcmds"
@$out ${issue_log}
messages
run job=backup-bareos-fd-issue2233-small yes
run job=backup-bareos-fd-issue2233 yes
run job=backup-bareos-fd-issue2233-huge yes
run job=backup-bareos-fd-issue2233 yes
run job=backup-bareos-fd-issue2233 yes
wait
messages
quit
END_OF_DATA

run_bconsole

queued_jobs=$(grep -c "Job queued." "${issue_log}")
if [[ "${queued_jobs}" -ne "${job_count}" ]]; then
  echo "Expected ${job_count} queued jobs, found ${queued_jobs}."
  estat=1
fi

successful_backups=$(grep -c "Termination:.*Backup OK" "${issue_log}")
if [[ "${successful_backups}" -ne "${job_count}" ]]; then
  echo "Expected ${job_count} successful backups, found ${successful_backups}."
  estat=1
fi

expect_grep "Using just in time reservation for job" \
  "${logdir}/bareos.log" \
  "Issue 2233 regression test did not use Just In Time reservation."

expect_not_grep "The number of files mismatch! Volume=" \
  "${logdir}/bareos.log" \
  "Issue 2233 regression detected: tape file count mismatch warning emitted."

expect_not_grep "Correcting Catalog" \
  "${logdir}/bareos.log" \
  "Issue 2233 regression detected: storage daemon corrected stale tape state."

check_for_zombie_jobs storage=VirtualTape

end_test
exit 0
