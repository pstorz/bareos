#ifndef BAREOS_DIRD_SUBSCRIPTION_TRUST_ANCHOR_H_
#define BAREOS_DIRD_SUBSCRIPTION_TRUST_ANCHOR_H_

namespace directordaemon {

/*
 * Embedded subscription trust anchor generated at CMake configure time from:
 * @SUBSCRIPTION_TRUST_ANCHOR_SOURCE@
 */
inline constexpr const char kEmbeddedSubscriptionTrustAnchor[]
    = R"SUBTA(
@SUBSCRIPTION_TRUST_ANCHOR_PEM@)SUBTA";

}  // namespace directordaemon

#endif  // BAREOS_DIRD_SUBSCRIPTION_TRUST_ANCHOR_H_
